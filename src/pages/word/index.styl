.word-page
  padding-bottom: 14rem
  .see-symbol
    font-size: 40rpx;
    display: inline-block;
    width: 1em;
    vertical-align: -0.1em;
    font-family: seesymbol;

  .word-qrcode-trigger
    width: 52rpx
    height: 52rpx
    border-radius: 12rpx
    border: 2rpx solid #b9ac9f
    background: #f5f2ed
    display: flex
    align-items: center
    justify-content: center

  .qrcode-popup-mask
    position: fixed
    top: 0
    left: 0
    right: 0
    bottom: 0
    z-index: 1200
    background: rgba(0, 0, 0, .45)
    display: flex
    align-items: center
    justify-content: center
    padding: 32rpx
    box-sizing: border-box

  .qrcode-popup-body
    width: 520rpx
    max-width: 100%
    background: #fff
    border-radius: 16rpx
    padding: 24rpx
    box-sizing: border-box

  .qrcode-popup-image
    width: 100%
    height: 472rpx
    border-radius: 12rpx
    background: #f8f7f5

  .qrcode-popup-tip
    margin-top: 18rpx
    text-align: center
    font-size: 26rpx
    color: #8e7c6d

  .qrcode-save-btn
    margin-top: 20rpx
    height: 76rpx
    border-radius: 12rpx
    background: #b9ac9f
    color: #fff
    font-size: 28rpx
    display: flex
    align-items: center
    justify-content: center
